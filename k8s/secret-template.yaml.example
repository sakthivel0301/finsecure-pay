# TEMPLATE ONLY - do NOT put real values here or commit real secrets.
# Create the real secrets from the command line instead:
#   kubectl -n finsecure create secret generic finsecure-secrets \
#       --from-literal=DB_PASSWORD='<value>'
# For Docker Hub pulls from a private repo:
#   kubectl -n finsecure create secret docker-registry dockerhub-cred \
#       --docker-username=<user> --docker-password=<access-token>
apiVersion: v1
kind: Secret
metadata:
  name: finsecure-secrets
  namespace: finsecure
type: Opaque
stringData:
  DB_PASSWORD: "REPLACE_ME_VIA_CLI"
